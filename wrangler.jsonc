{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lip-service",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Rate Limiting bindings (period must be 10 or 60 seconds).
  // *_IP limits each client; *_ALL is a global ceiling keyed on a constant.
  "ratelimits": [
    { "name": "RL_DG_IP", "namespace_id": "2601", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_DG_ALL", "namespace_id": "2602", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_AI_IP", "namespace_id": "2603", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_AI_ALL", "namespace_id": "2604", "simple": { "limit": 30, "period": 60 } }
  ]
}
