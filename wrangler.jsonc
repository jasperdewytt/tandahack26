{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mouth-alibi",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Stage dub: one Durable Object holds the app-wide dub limits, in-flight dedupe and cache.
  "durable_objects": { "bindings": [{ "name": "DUB", "class_name": "DubGateDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DubGateDO"] }],
  // Cloudflare Rate Limiting bindings (period must be 10 or 60 seconds).
  // *_IP limits each client (venue Wi-Fi shares one IP, so keep it generous);
  // *_ALL is a global ceiling keyed on a constant: 30 Sonnet calls/min is ~US$0.12/min max.
  "ratelimits": [
    { "name": "RL_DG_IP", "namespace_id": "2601", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_DG_ALL", "namespace_id": "2602", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_AI_IP", "namespace_id": "2603", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_AI_ALL", "namespace_id": "2604", "simple": { "limit": 30, "period": 60 } }
  ]
}
