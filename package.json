{
  "name": "lip-service",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild app/main.ts --bundle --format=esm --target=es2020 --minify --sourcemap --outfile=public/app.js",
    "index": "node scripts/build-index.mjs",
    "check": "tsc --noEmit",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "qrcode-generator": "^2.0.4"
  }
}
